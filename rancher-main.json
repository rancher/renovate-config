{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Restrict BCI images to maintained versions only",
      "allowedVersions": "<16.1",
      "matchPackageNames": [
        "/^registry\\.suse\\.com\\/bci\\//",
        "/^registry\\.suse\\.com\\/suse\\/sle15\\//"
      ]
    },
    {
      "matchPackageNames": [
        "golang",
        "go",
        "rancher/hardened-build-base",
        "registry.suse.com/bci/golang",
        "registry.opensuse.org/opensuse/bci/golang"
      ],
      "allowedVersions": "<1.28.0"
    },
    {
      "matchDatasources": [
        "golang-version"
      ],
      "allowedVersions": "<1.28.0"
    },
    {
      "description": "Keep major and minor Go workflow values compatible with Renovate replacement validation",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["go-workflow-minor"],
      "allowedVersions": "/^1\\.(?:\\d|1\\d|2[0-7])\\.0$/"
    },
    {
      "description": "Group all Go toolchain update types on main",
      "matchManagers": ["gomod", "custom.regex", "dockerfile", "github-actions"],
      "matchPackageNames": ["go", "golang", "rancher/hardened-build-base", "registry.suse.com/bci/golang", "registry.opensuse.org/opensuse/bci/golang", "golangci/golangci-lint", "golangci/golangci-lint-action", "github.com/golangci/golangci-lint", "github.com/golangci/golangci-lint/v2"],
      "groupName": "Go toolchain",
      "commitMessageExtra": "{{#if upgrades.0.newVersion}}to v{{upgrades.0.newVersion}}{{/if}}",
      "separateMajorMinor": false,
      "minimumGroupSize": 3
    },
    {
      "description": "Allow a single Go patch update to open a PR on its own",
      "matchManagers": ["gomod", "custom.regex", "dockerfile", "github-actions"],
      "matchPackageNames": ["go", "golang", "rancher/hardened-build-base", "registry.suse.com/bci/golang", "registry.opensuse.org/opensuse/bci/golang"],
      "matchUpdateTypes": ["patch"],
      "minimumGroupSize": 1
    },
    {
      "description": "Let the go directive open a PR on its own without a toolchain directive",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "matchDatasources": ["golang-version"],
      "matchJsonata": ["$not($exists(extractedConstraints.golang))"],
      "minimumGroupSize": 1
    },
    {
      "description": "Apply Go version cap to module directives with a toolchain",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "matchDatasources": ["golang-version"],
      "matchJsonata": ["$exists(extractedConstraints.golang)"],
      "allowedVersions": "/^1\\.(?:\\d|1\\d|2[0-7])\\.0$/"
    },
    {
      "description": "Apply Go version cap to module directives without a toolchain",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "matchDatasources": ["golang-version"],
      "matchJsonata": ["$not($exists(extractedConstraints.golang))"],
      "allowedVersions": "/^(?:1\\.(?:\\d|1\\d|2[0-7])\\.0|{{{major}}}\\.{{{minor}}}\\.\\d+)$/"
    },
    {
      "description": "Allow golangci-lint action updates after seven days to be in sync with go bumps",
      "matchPackageNames": ["golangci/golangci-lint-action"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "gomod",
        "custom.regex",
        "dockerfile"
      ],
      "matchPackageNames": [
        "rancher/kubectl",
        "kubernetes/kubernetes",
        "k8s.io/kubernetes",
        "kubectl-amd64",
        "kubectl-arm64",
        "kubectl-amd64-checksum",
        "kubectl-arm64-checksum",
        "kubectl-version"
      ],
      "allowedVersions": "<1.38.0"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "!k8s.io/kubernetes",
        "!k8s.io/gengo",
        "!k8s.io/gengo/**",
        "!k8s.io/utils",
        "!k8s.io/utils/**",
        "!k8s.io/kube-openapi",
        "!k8s.io/kube-openapi/**",
        "k8s.io/**"
      ],
      "allowedVersions": "<0.38.0"
    },
    {
      "matchPackageNames": ["rancherlabs/slsactl", "rancherlabs/slsactl/**"],
      "groupName": "slsactl",
      "minimumGroupSize": 2
    }
  ]
}
